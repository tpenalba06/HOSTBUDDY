SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_URL="https://your-project.supabase.co"
# Server only. Required by client.server.ts; never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=""
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Server only. Start with test keys; never prefix these with VITE_.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_WEBHOOK_SECRET=""
STRIPE_PRICE_BASE=""
STRIPE_PRICE_EXTRA=""
HOSTBUDDY_APP_URL="https://your-current-hostbuddy-domain"
HOSTBUDDY_CONNECT_APP_URL="https://your-current-hostbuddy-domain"
# Server/GitHub shared secret for billing-sync. Distinct by environment.
BILLING_SYNC_SECRET=""
# Keep false during preparation; arm Live only after explicit commercial approval.
STRIPE_LIVE_VERIFIED="false"
# 32-byte encryption key in base64, for tenant-scoped PMS credentials.
PMS_ENCRYPTION_KEY=""

# Concierge AI stays disabled by default. Server only; never prefix with VITE_.
# Read docs/nona-cloud-metered-20261019.md before any activation.
AI_GATEWAY_API_KEY=
NONA_AI_ENABLE=
NONA_AI_BILLING_ENVELOPE=

# Prepared metered cloud path. ALL values stay empty until explicit approval.
# The older NONA_AI_* flags no longer authorize cloud expenditure.
# Billing review is a dated server-side JSON evidence record, never a boolean.
NONA_CLOUD_ENABLE=
NONA_CLOUD_SCOPE=
NONA_CLOUD_BILLING_REVIEW=
NONA_CONCIERGE_SESSION_SECRET=
# Only set to the actual sanitized hosting proxy: cloudflare or vercel.
NONA_TRUSTED_PROXY=

# Private Lovable editor recipe only; separate TEST keys, never VITE_.
# Does not enable AI by itself. Requires a dated Free review, approved window,
# existing TEST ledger, and explicit private-free-test-v1 / hosted-free-test-v1 gates.
# Public/published domains remain excluded; no monthly activation here.
NONA_OLLAMA_PREVIEW_ENABLE=
NONA_TEST_SUPABASE_SERVICE_ROLE_KEY=
NONA_TEST_CONCIERGE_SESSION_SECRET=
OLLAMA_API_KEY=
NONA_OLLAMA_TEST_ENABLE=
NONA_OLLAMA_FREE_REVIEW=
NONA_OLLAMA_TEST_PROPERTY_ID=
