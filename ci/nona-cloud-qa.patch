@@ -0,0 +1,145 @@
+import { build } from "vite";
+import react from "@vitejs/plugin-react";
+import tailwindcss from "@tailwindcss/vite";
+import { mkdir, readFile, writeFile, cp } from "node:fs/promises";
+import { resolve, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+const root = resolve(dirname(fileURLToPath(import.meta.url)), "../..");
+const source = resolve(root, ".output/hosted-test-source"),
+  dist = resolve(root, ".output/hosted-test-deploy");
+await mkdir(source, { recursive: true });
+await mkdir(resolve(dist, "api"), { recursive: true });
+await writeFile(
+  resolve(source, "disabled-gateway.ts"),
+  "export function createMeteredCloudDependencies(){return undefined;}\n",
+);
+await build({
+  configFile: false,
+  root,
+  publicDir: false,
+  logLevel: "warn",
+  ssr: { noExternal: true },
+  define: { "process.env.NODE_ENV": JSON.stringify("production") },
+  resolve: {
+    alias: {
+      "@": resolve(root, "src"),
+      "./concierge-cloud.server": resolve(source, "disabled-gateway.ts"),
+    },
+  },
+  build: {
+    ssr: "scripts/validation/nona-hosted-test-entry.ts",
+    target: "node22",
+    outDir: resolve(dist, "server"),
+    emptyOutDir: true,
+  },
+});
+await writeFile(
+  resolve(dist, "api/test.mjs"),
+  `import {hostedTestResponse} from '../server/nona-hosted-test-entry.js';
+export default async function handler(req,res){
+ try{
+ const origin='https://'+process.env.VERCEL_URL;
+ const kind=req.query.kind; const locale=req.query.locale||'fr';
+ const url=new URL('/api/test',origin);url.searchParams.set('kind',kind);url.searchParams.set('locale',locale);
+ const headers=new Headers();for(const [key,value] of Object.entries(req.headers))if(value)headers.set(key,Array.isArray(value)?value.join(','):value);
+ const result=await hostedTestResponse(new Request(url,{method:req.method,headers,...(req.method==='POST'?{body:typeof req.body==='string'?req.body:JSON.stringify(req.body)}:{})}));
+ res.statusCode=result.status;for(const[key,value]of result.headers)res.setHeader(key,value);res.end(Buffer.from(await result.arrayBuffer()));
+ }catch{res.statusCode=503;res.end(JSON.stringify({error:'test_unavailable'}));}
+}\n`,
+);
+let entry = await readFile(resolve(root, "scripts/validation/nona-local-ui/entry.tsx"), "utf8");
+// TEST-only diagnostics: no message, guide body, contact, receipt or secret.
+// Browser evidence can correlate a visible reply with durable server metering.
+entry = entry.replace(
+  "return response.json();",
+  `const turn = await response.json();
+  console.info("NONA_TEST_TURN " + JSON.stringify({requestId:request.requestId,locale:request.locale,mode:turn.mode,usage:turn.usage,nextStep:turn.nextStep,quote:turn.quote}));
+  return turn;`,
+);
+entry = entry
+  .replace('JSON.stringify({ ...request, mode: "local" })', "JSON.stringify(request)")
+  .replace('conciergeSlug="nona-local"', 'conciergeSlug="nona-hosted-test"')
+  .replace(
+    "{nonaVisualCopy(locale).local}",
+    "TEST : données fictives · Ollama Cloud Free quand autorisé · aucune commande ni paiement.",
+  )
+  .replace('import { nonaVisualCopy } from "@/lib/nona-visual-copy";', "")
+  .replace(
+    "Le livret local est indisponible. Relance Ouvrir-NONA.cmd.",
+    "Le guide TEST est momentanément indisponible.",
+  );
+await writeFile(resolve(source, "entry.tsx"), entry);
+await writeFile(
+  resolve(source, "index.html"),
+  '<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>NONA — guide TEST cloud</title></head><body><div id="root"></div><script type="module" src="./entry.tsx"></script></body></html>',
+);
+const ux = resolve(root, "../nona-lovable-sync/src");
+const overrides = new Map(
+  [
+    "components/guest/GuideView.tsx",
+    "components/guest/GuideContent.tsx",
+    "lib/ux-copy.ts",
+    "lib/i18n.tsx",
+    "styles/nona-art-direction.css",
+  ].map((f) => [resolve(root, "src", f).replaceAll("\\", "/"), resolve(ux, f)]),
+);
+await build({
+  configFile: false,
+  root: source,
+  publicDir: false,
+  logLevel: "warn",
+  base: "/",
+  plugins: [
+    {
+      name: "preserve-unpublished-ux-snapshot",
+      enforce: "pre",
+      resolveId(id) {
+        if (id.endsWith("/lib/ux-copy")) return resolve(ux, "lib/ux-copy.ts");
+      },
+      async load(id) {
+        const exact = id.split("?")[0].replaceAll("\\", "/");
+        if (overrides.has(exact)) return readFile(overrides.get(exact), "utf8");
+        if (exact === resolve(root, "src/components/guest/NonaConcierge.tsx").replaceAll("\\", "/"))
+          return (await readFile(exact, "utf8")).replace("Nona · IA locale", "Nona · TEST cloud");
+      },
+    },
+    react(),
+    tailwindcss(),
+  ],
+  resolve: { alias: { "@": resolve(root, "src") } },
+  build: { outDir: resolve(dist, "public"), emptyOutDir: true },
+});
+await cp(resolve(root, "public"), resolve(dist, "public"), { recursive: true });
+await cp(
+  resolve(root, "scripts/validation/nona-hosted-mobile.html"),
+  resolve(dist, "public/mobile.html"),
+);
+await writeFile(
+  resolve(dist, "package.json"),
+  JSON.stringify({ private: true, type: "module", engines: { node: "22.x" } }),
+);
+await writeFile(
+  resolve(dist, "vercel.json"),
+  JSON.stringify({
+    version: 2,
+    framework: null,
+    buildCommand: "",
+    installCommand: "",
+    outputDirectory: "public",
+    functions: { "api/test.mjs": { maxDuration: 30 } },
+    rewrites: [
+      { source: "/chat", destination: "/api/test?kind=chat" },
+      { source: "/local-guide", destination: "/api/test?kind=guide" },
+    ],
+    headers: [
+      {
+        source: "/(.*)",
+        headers: [
+          { key: "X-Robots-Tag", value: "noindex, nofollow" },
+          { key: "Referrer-Policy", value: "no-referrer" },
+        ],
+      },
+    ],
+  }),
+);
+console.log("HOSTED_TEST_PACKAGE_BUILT_NO_CREDENTIALS_NO_INFERENCE");
diff --git a/scripts/validation/nona-beta-browser.mjs b/scripts/validation/nona-beta-browser.mjs
new file mode 100644
index 0000000..726c333
--- /dev/null
+++ b/scripts/validation/nona-beta-browser.mjs
@@ -0,0 +1,148 @@
+import assert from "node:assert/strict";
+import { writeFile } from "node:fs/promises";
+const { chromium } = await import(process.env.HOSTBUDDY_PLAYWRIGHT_MODULE);
+const browser = await chromium.launch({ headless: true });
+const results = [];
+let nextChatAt = 0;
+try {
+  for (const [name, width, height] of [
+    ["desktop", 1440, 1000],
+    ["mobile", 390, 844],
+  ]) {
+    const context = await browser.newContext({
+      viewport: { width, height },
+      locale: "fr-FR",
+      timezoneId: "Europe/Paris",
+      isMobile: name === "mobile",
+      hasTouch: name === "mobile",
+    });
+    // No provider key, customer data, remote site or billable call on the runner.
+    await context.route("**/*", async (route) => {
+      const url = new URL(route.request().url());
+      if (url.hostname !== "127.0.0.1") return route.abort();
+      if (url.pathname === "/chat" && route.request().method() === "POST") {
+        // Pace EVERY request, including form quote refreshes and both devices,
+        // within the real 20/minute shared network limit. No guard is disabled.
+        const at = Math.max(Date.now(), nextChatAt);
+        nextChatAt = at + 3200;
+        await new Promise((resolve) => setTimeout(resolve, Math.max(0, at - Date.now())));
+      }
+      return route.continue();
+    });
+    const page = await context.newPage();
+    const errors = [];
+    page.on("pageerror", (error) => errors.push(error.message));
+    try {
+      const guideResponse = page.waitForResponse(
+        (r) => new URL(r.url()).pathname === "/local-guide",
+      );
+      await page.goto("http://127.0.0.1:4196/", { waitUntil: "networkidle" });
+      const source = await (await guideResponse).json();
+      const slot = source.services.find((s) => s.id === "bf").bookingConfig.slots[0];
+      const sourceDate = new Intl.DateTimeFormat("en-CA", { timeZone: "Europe/Paris" }).format(
+        new Date(slot),
+      );
+      await page.locator(".nona-launcher").click();
+      await page.getByRole("dialog").waitFor();
+      const send = async (message, label) => {
+        const pending = page.waitForResponse(
+          (r) =>
+            r.url().endsWith("/chat") &&
+            r.request().method() === "POST" &&
+            r.request().postDataJSON()?.message === message,
+        );
+        await page.locator(".nona-composer textarea").fill(message);
+        await page.locator(".nona-composer textarea").press("Enter");
+        const response = await pending;
+        assert.equal(response.status(), 200);
+        const turn = await response.json();
+        assert.equal(turn.usage.modelCalls, 0);
+        assert.equal(turn.mode, "guided");
+        await page.getByRole("dialog").getByText(turn.text, { exact: true }).last().waitFor();
+        if (turn.nextStep === "ready") {
+          assert.equal(turn.quote?.totalCents, 7500);
+          // The form independently refreshes its server quote. An API success
+          // alone is not proof that its rendered total has finished loading.
+          await page
+            .getByRole("dialog")
+            .getByText("Total demandé : 75.00 €", { exact: true })
+            .last()
+            .waitFor({ state: "visible", timeout: 30000 });
+        }
+        await page.screenshot({ path: `qa-results/${name}-${label}.png` });
+        results.push({
+          name,
+          label,
+          message,
+          mode: turn.mode,
+          nextStep: turn.nextStep,
+          quote: turn.quote,
+          text: turn.text,
+        });
+        return turn;
+      };
+      await send(`Petit-déjeuner pour le ${sourceDate}`, "breakfast-start");
+      const quantity = await send("Pour trois personnes", "breakfast-quantity");
+      assert.ok(quantity.choices[0]?.message, "server must offer a real slot");
+      await send(quantity.choices[0].message, "breakfast-time");
+      const breakfast = await send("Classique", "breakfast-ready");
+      assert.equal(breakfast.quote?.totalCents, 7500);
+      assert.equal(breakfast.nextStep, "ready");
+      const social = await send(
+        "Merci. On fête notre anniversaire ici, qu’est-ce qu’on pourrait faire pour se détendre après le trajet ?",
+        "topic-change",
+      );
+      assert.equal(social.nextStep, null);
+      assert.equal(social.quote, null);
+      const massage = await send(
+        `Je change de sujet : je voudrais un massage pour le ${sourceDate}, pour une personne.`,
+        "massage",
+      );
+      assert.equal(massage.nextStep, "time");
+      assert.equal(massage.draft.quantity, 1);
+      assert.equal(massage.draft.date, breakfast.draft.date);
+      assert.equal(massage.draft.time, undefined);
+      const resumed = await send("Revenons au petit-déjeuner", "breakfast-resumed");
+      assert.equal(resumed.quote?.totalCents, 7500);
+      for (const [locale, message] of [
+        ["fr", "Quel est le code de la boîte à clés ?"],
+        ["en", "What is the key box code?"],
+        ["es", "¿Cuál es el código de la caja de llaves?"],
+        ["de", "Hallo Nona, wir feiern unseren Hochzeitstag. Hast du einen lieben Rat?"],
+        ["it", "Qual è il codice della cassetta delle chiavi?"],
+        ["pt", "Qual é o código da caixa de chaves?"],
+      ]) {
+        await page.locator(".nona-language select").selectOption(locale);
+        const unknown = await send(message, `language-${locale}`);
+        assert.equal(unknown.nextStep, null);
+        assert.equal(unknown.quote, null);
+      }
+      assert.deepEqual(errors, []);
+      assert.equal(
+        await page.evaluate(() => document.documentElement.scrollWidth > innerWidth + 2),
+        false,
+      );
+      // Never click a booking confirmation, fill contacts or execute a payment.
+    } catch (error) {
+      results.push({ name, error: error.message, pageErrors: errors });
+      await page.screenshot({ path: `qa-results/${name}-failure.png`, fullPage: true });
+      process.exitCode = 1;
+    } finally {
+      await context.close();
+    }
+  }
+} finally {
+  await browser.close();
+  await writeFile(
+    "qa-results/browser.json",
+    JSON.stringify(
+      {
+        kind: "shared UI and compiled API, synthetic data, guided fallback only; not a live AI test",
+        actualModelCalls: 0,
+        results,
+      },
+      null,
+      2,
+    ),
+  );
+}
diff --git a/scripts/validation/nona-cloud-preflight.mjs b/scripts/validation/nona-cloud-preflight.mjs
