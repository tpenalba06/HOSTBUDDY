+  letter-spacing: 0.04em;
+}
+.manager-shell .manager-shell-sidebar nav > :is(a, button):not(.manager-nav-add) {
+  margin-top: 0;
+  border: 0;
+  color: var(--foreground);
+  background: transparent;
+}
+.manager-shell .manager-shell-sidebar nav > .manager-nav-add {
+  margin: 0 0 4px;
+  background: var(--primary);
+  color: var(--primary-foreground);
+  font-weight: 600;
+}
+.manager-shell .manager-shell-sidebar nav > .manager-nav-add svg {
+  color: currentColor;
+}
+.manager-shell
+  .manager-shell-sidebar
+  nav
+  > :is(a, button):not(.manager-nav-add)[aria-current="page"] {
+  background: var(--secondary);
+  color: var(--primary);
+  font-weight: 600;
+}
+.manager-shell
+  .manager-shell-sidebar
+  nav
+  > :is(a, button):not(.manager-nav-add)[aria-current="page"]
+  svg {
+  color: currentColor;
+}
+.manager-shell .manager-shell-mobile [aria-current="page"] {
+  background: var(--secondary);
+  color: var(--primary);
+}
+.manager-shell .manager-property-toolbar {
+  margin-top: 22px;
+}
+.manager-shell .manager-properties-heading {
+  grid-template-columns: minmax(0, 1fr) auto;
+}
+.manager-shell .manager-property-no-results {
+  grid-column: 1 / -1;
+}
+.manager-shell .manager-property-quick-actions {
+  flex-wrap: wrap;
+}
+.manager-shell .manager-property-quick-actions :is(a, button) {
+  min-height: 44px;
+  white-space: normal;
+  text-align: center;
+  line-height: 1.35;
+}
+.manager-shell .manager-property-quick-actions .manager-property-edit {
+  background: var(--primary);
+  border-color: var(--primary);
+  color: var(--primary-foreground);
+}
+.manager-shell .manager-property-menu summary {
+  width: 44px;
+  height: 44px;
+}
+.manager-shell .manager-property-menu summary:focus-visible {
+  outline: 2px solid var(--primary);
+  outline-offset: 2px;
+  border-radius: 8px;
+}
+.manager-shell .manager-property-search:focus-within {
+  outline: 2px solid var(--primary);
+  outline-offset: 2px;
+}
+@media (hover: hover) {
+  .manager-shell .manager-shell-sidebar nav > :is(a, button):not(.manager-nav-add):hover {
+    background: var(--secondary);
+  }
+}
+@container (max-width: 1000px) {
+  .manager-shell .manager-properties-heading {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
+@container (max-width: 450px) {
+  .manager-shell .manager-property-toolbar {
+    gap: 8px;
+  }
+  .manager-shell .manager-property-sort {
+    max-width: 120px;
+  }
+}
diff --git a/src/styles/ux-foundations.css b/src/styles/ux-foundations.css
new file mode 100644
index 0000000..6db2ee0
--- /dev/null
+++ b/src/styles/ux-foundations.css
@@ -0,0 +1,265 @@
+/* Shared feedback: preserve official tokens, animate only composited properties. */
+:root {
+  --nona-duration-fast: 140ms;
+  --nona-duration-panel: 220ms;
+  --nona-ease: cubic-bezier(0.2, 0.7, 0.2, 1);
+}
+:where(button, a, input, select, textarea, summary) {
+  -webkit-tap-highlight-color: transparent;
+}
+:where(button:not(:disabled), a[href], summary) {
+  touch-action: manipulation;
+}
+:where(button, a, input, select, textarea, summary):focus-visible {
+  outline: 2px solid var(--primary);
+  outline-offset: 4px;
+}
+:where(button:disabled, [aria-disabled="true"]) {
+  cursor: not-allowed;
+}
+:where(.btn, .hb-button, .hb-icon-button, .nona-demo-tab, button) {
+  transition:
+    background-color var(--nona-duration-fast) ease,
+    color var(--nona-duration-fast) ease,
+    border-color var(--nona-duration-fast) ease,
+    box-shadow var(--nona-duration-fast) ease,
+    transform var(--nona-duration-fast) var(--nona-ease);
+}
+:where(.btn, .hb-button, .hb-icon-button, .nona-demo-tab, .manager-property-card button):active:not(
+    :disabled
+  ) {
+  transform: translateY(1px) scale(0.985);
+}
+@media (hover: hover) and (prefers-reduced-motion: no-preference) {
+  :where(.hb-tile, .hb-service-card):hover {
+    box-shadow: 0 5px 18px #4b413814;
+  }
+}
+.nona-skip-link {
+  position: fixed;
+  inset: 8px auto auto 8px;
+  z-index: 100;
+  transform: translateY(-180%);
+  padding: 12px 20px;
+  border-radius: 10px;
+  background: var(--card);
+  color: var(--primary);
+  box-shadow: var(--shadow-soft);
+}
+.nona-skip-link:focus {
+  transform: none;
+}
+.nona-navigation-progress {
+  position: fixed;
+  inset: 0 0 auto;
+  height: 3px;
+  background: var(--primary);
+  z-index: 100;
+  animation: nona-progress 1s ease-in-out infinite alternate;
+  transform-origin: left;
+}
+@keyframes nona-progress {
+  from {
+    transform: scaleX(0.15);
+  }
+  to {
+    transform: scaleX(0.9);
+  }
+}
+.nona-workspace-skeleton {
+  display: grid;
+  gap: 20px;
+  padding: 32px;
+  min-height: 420px;
+}
+.nona-workspace-skeleton > span {
+  display: block;
+  height: 72px;
+  border-radius: 12px;
+  background: var(--muted);
+  animation: nona-skeleton 1.2s ease-in-out infinite alternate;
+}
+.nona-workspace-skeleton > span:first-child {
+  width: 45%;
+  height: 38px;
+}
+@keyframes nona-skeleton {
+  to {
+    opacity: 0.45;
+  }
+}
+.nona-marketing-header {
+  position: relative;
+  z-index: 30;
+}
+.nona-demo-entry {
+  display: grid;
+  align-items: center;
+  gap: 28px;
+  max-width: 1000px;
+  margin-inline: auto;
+  padding: clamp(20px, 4vw, 48px);
+  border: 1px solid #ffffff35;
+  border-radius: 20px;
+}
+.nona-demo-entry .btn {
+  white-space: normal;
+  text-align: center;
+}
+.nona-demo-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  min-height: 68px;
+  padding: 8px max(16px, calc((100vw - 1300px) / 2));
+  border-bottom: 1px solid var(--border);
+  background: var(--background);
+}
+.nona-demo-toolbar {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  padding: 16px;
+  background: var(--background);
+}
+.nona-demo-tabs {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  padding: 4px;
+  gap: 4px;
+  border-radius: 14px;
+  background: var(--secondary);
+}
+.nona-demo-tabs .nona-demo-tab {
+  color: var(--foreground);
+  background: transparent;
+  border-radius: 10px;
+  padding-inline: clamp(12px, 2vw, 24px);
+}
+.nona-demo-tabs .nona-demo-tab[aria-selected="true"] {
+  background: var(--primary);
+  color: var(--primary-foreground);
+  box-shadow: 0 2px 8px #4b413816;
+}
+.nona-demo-context {
+  padding: 0 20px 20px;
+  max-width: 800px;
+  color: var(--foreground);
+}
+.nona-demo-context small {
+  display: block;
+  margin-top: 6px;
+  color: var(--muted-foreground);
+}
+.demo-container[data-layout="page"] > .demo-frame {
+  overflow: visible;
+}
+.demo-container[data-layout="page"] .demo-viewport {
+  height: auto;
+  min-height: 65dvh;
+  overflow: visible;
+}
+.demo-container[data-layout="page"] > .relative > .nona-concierge[data-demo] {
+  position: fixed;
+  bottom: 0;
+}
+.demo-container [role="tabpanel"][hidden] {
+  display: none;
+}
+.demo-container [role="tabpanel"] {
+  outline-offset: -3px;
+}
+.demo-container[data-layout="embedded"] .nona-demo-toolbar {
+  justify-content: center;
+}
+.nona-demo-page .manager-shell:not(.manager-shell-embedded) {
+  min-height: 75dvh;
+}
+.nona-demo-page .demo-frame {
+  border-radius: 16px 16px 0 0;
+}
+.nona-concierge .nona-launcher {
+  position: relative;
+  overflow: visible;
+}
+.nona-launcher-caption {
+  position: absolute;
+  bottom: calc(100% + 5px);
+  right: 0;
+  width: max-content;
+  max-width: 170px;
+  white-space: normal;
+  padding: 7px 12px;
+  border: 1px solid var(--border);
+  border-radius: 14px 14px 3px 14px;
+  background: var(--card);
+  color: #4b4138;
+  font-size: 13px;
+  line-height: 1.3;
+  font-weight: 600;
+  box-shadow: var(--shadow-soft);
+}
+.nona-thinking {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 10px 0;
+  color: var(--muted-foreground);
+  font-size: 14px;
+}
+@media (prefers-reduced-motion: no-preference) {
+  .nona-concierge .nona-panel:not([hidden]) {
+    animation: nona-panel-enter var(--nona-duration-panel) var(--nona-ease) both;
+  }
+  @keyframes nona-panel-enter {
+    from {
+      opacity: 0;
+      transform: translateY(8px);
+    }
+    to {
+      opacity: 1;
+      transform: none;
+    }
+  }
+}
+@media (max-width: 600px) {
+  .nona-demo-toolbar {
+    flex-wrap: wrap;
+    gap: 10px;
+    padding: 12px;
+  }
+  .nona-demo-tabs {
+    flex: 1 1 100%;
+  }
+  .nona-demo-create {
+    min-height: 44px;
+    width: 100%;
+    font-size: 14px;
+  }
+  .nona-demo-context {
+    padding: 0 16px 16px;
+    font-size: 14px;
+  }
+  .nona-demo-page .demo-frame {
+    border-radius: 0;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    scroll-behavior: auto !important;
+  }
+  :where(.btn, button, a, .hb-tile, .hb-button, .hb-icon-button, .nona-demo-tab) {
+    transition-duration: 0s !important;
+  }
+  :where(.btn, button, a):active {
+    transform: none !important;
+  }
+  .nona-navigation-progress,
+  .nona-workspace-skeleton > span {
+    animation: none;
+  }
+}
