+++ b/src/components/shared/CopyButton.tsx
@@ -0,0 +1,39 @@
+import { useEffect, useState } from "react";
+import { Button } from "@/components/ui/button";
+import { useI18n } from "@/lib/i18n";
+import { uxCopy } from "@/lib/ux-copy";
+
+export function CopyButton({ value, label }: { value: string; label: string }) {
+  const { locale } = useI18n();
+  const ux = uxCopy(locale);
+  const [status, setStatus] = useState<"idle" | "pending" | "copied" | "error">("idle");
+  useEffect(() => {
+    if (status !== "copied") return;
+    const timer = setTimeout(() => setStatus("idle"), 2500);
+    return () => clearTimeout(timer);
+  }, [status]);
+  return (
+    <div>
+      <Button
+        type="button"
+        variant="outline"
+        disabled={status === "pending"}
+        onClick={async () => {
+          setStatus("pending");
+          try {
+            if (!navigator.clipboard?.writeText) throw new Error("clipboard unavailable");
+            await navigator.clipboard.writeText(value);
+            setStatus("copied");
+          } catch {
+            setStatus("error");
+          }
+        }}
+      >
+        {status === "copied" ? ux.copied : label}
+      </Button>
+      <span role="status" className={status === "error" ? "mt-2 block text-sm" : "sr-only"}>
+        {status === "error" ? ux.copyFailed : status === "copied" ? ux.copied : ""}
+      </span>
+    </div>
+  );
+}
diff --git a/src/components/shared/NavigationFeedback.tsx b/src/components/shared/NavigationFeedback.tsx
new file mode 100644
index 0000000..ab0a043
--- /dev/null
+++ b/src/components/shared/NavigationFeedback.tsx
@@ -0,0 +1,23 @@
+import { useEffect, useState } from "react";
+import { useRouterState } from "@tanstack/react-router";
+import { useI18n } from "@/lib/i18n";
+
+/** Delayed feedback avoids a flash on instant navigation and announces slower loads. */
+export function NavigationFeedback() {
+  const pending = useRouterState({ select: (state) => state.status === "pending" });
+  const [visible, setVisible] = useState(false);
+  const { t } = useI18n();
+  useEffect(() => {
+    if (!pending) {
+      setVisible(false);
+      return;
+    }
+    const timer = setTimeout(() => setVisible(true), 180);
+    return () => clearTimeout(timer);
+  }, [pending]);
+  return visible ? (
+    <div className="nona-navigation-progress" role="status">
+      <span className="sr-only">{t("common.loading")}</span>
+    </div>
+  ) : null;
+}
